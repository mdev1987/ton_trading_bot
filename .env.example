# ============================================================
# TON PAPER / EMULATION TRADING BOT
# ============================================================

# Runtime safety mode.
# This project is intentionally emulation/paper only.
BOT_MODE=emulation

# ------------------------------------------------------------
# CoinGecko / GeckoTerminal
# ------------------------------------------------------------
# Demo API key from CoinGecko.
COINGECKO_DEMO_API_KEY=
COINGECKO_NETWORK=ton
COINGECKO_NEW_POOL_PAGES=1

# ------------------------------------------------------------
# DEX Screener
# ------------------------------------------------------------
DEXSCREENER_URL=https://api.dexscreener.com
DEXSCREENER_CHAIN_ID=ton

# ------------------------------------------------------------
# DexPaprika (optional: raises credit allowance 30k -> 100k,
# rate 15 -> 30 req/min; keyless works too)
# ------------------------------------------------------------
DEXPAPRIKA_API_KEY=
DEXPAPRIKA_URL=https://api.dexpaprika.com
# Second discovery source (newest TON pools) alongside CoinGecko.
DEXPAPRIKA_ENABLED=true
# Newest pools per scan (1-100). One request per pool-scan cycle.
DEXPAPRIKA_LIMIT=50

# ------------------------------------------------------------
# DeDust Router
# ------------------------------------------------------------
DEDUST_ROUTER_URL=https://api-mainnet.dedust.io/v1/router
DEDUST_BUY_SLIPPAGE_BPS=100
DEDUST_SELL_SLIPPAGE_BPS=100
DEDUST_MAX_SPLITS=1
DEDUST_MAX_ROUTE_LENGTH=1
# Bind paper BUYs to the exact discovered DeDust pool.
DEDUST_REQUIRE_DISCOVERED_POOL=true
# Reject a SELL quote if the router changes to another pool.
DEDUST_REQUIRE_SAME_POOL_ON_EXIT=true

# ------------------------------------------------------------
# TONAPI
# ------------------------------------------------------------
TONAPI_URL=https://tonapi.io
TONAPI_KEY=

# ------------------------------------------------------------
# TON Center
# ------------------------------------------------------------
TONCENTER_URL=https://toncenter.com
TONCENTER_API_KEY=

# Optional current-event infrastructure.
# Paper price monitoring does not depend on this.
TONCENTER_STREAM_ENABLED=false
TONCENTER_STREAM_ADDRESSES=
TONCENTER_STREAM_MIN_FINALITY=finalized

# ------------------------------------------------------------
# Paper account
# ------------------------------------------------------------
PAPER_INITIAL_BALANCE=1000
PAPER_POSITION_SIZE=10
PAPER_MAX_OPEN_POSITIONS=5

# Skip discovered pools below this CoinGecko-reported liquidity in USD.
# 0 disables the gate. Thin-LP micros slip hard; 10000 is a sane start.
MIN_LIQUIDITY_USD=0
PAPER_AUTO_BUY=true
ONE_POSITION_PER_TOKEN=true

# File-backed paper state: portfolio, seen pools/tokens, id counter.
# Survives restarts; no re-baseline, no lost positions.
STATE_FILE=./data/paper-state.json
STATE_SAVE_INTERVAL_MS=15000

# ------------------------------------------------------------
# Polling
# ------------------------------------------------------------
POOL_SCAN_INTERVAL_MS=30000
PRICE_POLL_INTERVAL_MS=1500
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=2
HTTP_RETRY_DELAY_MS=750

# ------------------------------------------------------------
# Position risk rules
# ------------------------------------------------------------
HARD_STOP_LOSS_PERCENT=15
TRAILING_ACTIVATION_PERCENT=40
TRAILING_DISTANCE_PERCENT=15

# Dynamic TP levels. Format: profit:sell,profit:sell,...
# 30:25 = at +30%, sell 25% of remaining position
# 60:25 = at +60%, sell 25% of remaining position
# 100:100 = at +100%, close the remainder
TAKE_PROFITS=30:25,60:25,100:100

# Include estimated entry/exit network fees in paper cash.
INCLUDE_NETWORK_FEES=true

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ------------------------------------------------------------
# Optional live-preflight adapters (NOT USED BY EMULATION)
# ------------------------------------------------------------
TONAPI_EMULATION_ENABLED=false
TONCENTER_EMULATION_ENABLED=false
